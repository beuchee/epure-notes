<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune permission (DEC-0005). Sauvegarde système fermée (DEC-0008) : voir data_extraction_rules.xml. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EpureNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EpureNotes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Texte partagé depuis une autre app : nouvelle note (SPEC F-10.1). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <!-- Tous les types : un fichier .md partagé depuis « Mes fichiers » doit pouvoir être proposé (F-10.4). -->
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Widget « Tâches » sur l'écran d'accueil (SPEC F-14, DEC-0016). Aucune permission. -->
        <receiver
            android:name=".system.TasksWidget"
            android:exported="true"
            android:label="@string/tasks_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>
        <!-- Widget « Tâches » pour l'écran verrouillé, contenu selon le réglage (DEC-0035). -->
        <receiver
            android:name=".system.TasksLockWidget"
            android:exported="true"
            android:label="@string/tasks_lock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_lock_widget_info" />
        </receiver>
    </application>

</manifest>
