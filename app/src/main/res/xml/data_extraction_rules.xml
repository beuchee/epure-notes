<?xml version="1.0" encoding="utf-8"?>
<!--
   Aucune donnée de l'app ne sort par la sauvegarde système (cloud) ni par le transfert
   d'appareil à appareil. Seule sauvegarde : la copie optionnelle dans un dossier choisi
   par l'utilisateur (DEC-0008, DEC-0019).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
